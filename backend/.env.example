# Copy to backend/.env and fill in the values. Do not commit backend/.env.
# FIREBASE_PRIVATE_KEY may use \n between lines; python-dotenv restores the newlines.
OPENAI_API_KEY="replace-with-openai-api-key"
PINECONE_API_KEY="replace-with-pinecone-api-key"
HF_TOKEN="replace-with-hf-token"
FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"
FIREBASE_TYPE="service_account"
FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
FIREBASE_PRIVATE_KEY_ID="replace-with-firebase-private-key-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="replace-with-firebase-client-email"
FIREBASE_CLIENT_ID="replace-with-firebase-client-id"
FIREBASE_AUTH_URI="replace-with-firebase-auth-uri"
FIREBASE_TOKEN_URI="replace-with-firebase-token-uri"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL="replace-with-firebase-auth-provider-x509-cert-url"
FIREBASE_CLIENT_X509_CERT_URL="replace-with-firebase-client-x509-cert-url"
FIREBASE_UNIVERSE_DOMAIN="replace-with-firebase-universe-domain"
PINECONE_INDEX="courses"
OPENAI_QUERY_MODEL="gpt-6-luna"
