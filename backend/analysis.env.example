# Modelo de configuração para análise isolada. Copie para backend/.env somente
# em um checkout descartável, preenchendo com credenciais de serviços de TESTE.
# O backend carrega backend/.env; este arquivo não é carregado automaticamente.
# Nunca use credenciais, projeto Firebase, banco ou índice de produção.

OPENAI_API_KEY=""
PINECONE_API_KEY=""
# Opcional: o código não lê HF_TOKEN diretamente.
HF_TOKEN=""
PINECONE_INDEX="courses-analysis"
OPENAI_QUERY_MODEL="gpt-6-luna"

FIREBASE_TYPE="service_account"
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""
FIREBASE_AUTH_URI=""
FIREBASE_TOKEN_URI=""
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=""
FIREBASE_CLIENT_X509_CERT_URL=""
FIREBASE_UNIVERSE_DOMAIN=""
FIREBASE_DATABASE_URL=""
