{
  "uid": "coursesphere-sre",
  "title": "CourseSphere — SRE",
  "tags": ["coursesphere", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second by instance",
      "datasource": {"type": "prometheus", "uid": "coursesphere-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (instance) (rate(coursesphere_http_requests_total{route!~\"/metrics|/health|/ready\"}[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2, "type": "timeseries", "title": "5xx error ratio",
      "datasource": {"type": "prometheus", "uid": "coursesphere-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(coursesphere_http_requests_total{status=~\"5..\",route!~\"/metrics|/health|/ready\"}[5m])) / clamp_min(sum(rate(coursesphere_http_requests_total{route!~\"/metrics|/health|/ready\"}[5m])), 0.000001)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 request latency",
      "datasource": {"type": "prometheus", "uid": "coursesphere-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(coursesphere_http_request_duration_seconds_bucket{route!~\"/metrics|/health|/ready\"}[5m])))"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4, "type": "timeseries", "title": "Authentication failures",
      "datasource": {"type": "prometheus", "uid": "coursesphere-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (operation) (rate(coursesphere_auth_events_total{outcome=\"failure\"}[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5, "type": "stat", "title": "Backend instances up",
      "datasource": {"type": "prometheus", "uid": "coursesphere-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(up{job=\"coursesphere\"})"}],
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 16}
    }
  ]
}
